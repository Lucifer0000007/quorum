{
  "mcpServers": {
    "falkordb": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@falkordb/mcpserver@1.3.0"],
      "env": {
        "FALKORDB_HOST": "localhost",
        "FALKORDB_PORT": "6379"
      }
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp@4.4.2"]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@0.0.83"]
    }
  }
}
